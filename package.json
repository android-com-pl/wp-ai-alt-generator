{
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "dev": "wp-scripts start",
    "dev:hot": "wp-scripts start --hot",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:github": "oxlint --format=github",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-pacer": "^0.24.1",
    "@wordpress/icons": "^19.0.0",
    "@wordpress/scripts": "^37.0.0",
    "husky": "^9.1.7",
    "ts-dom-utils": "^2.3.2",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/wordpress__admin": "^5.8.5",
    "@types/wordpress__block-editor": "^15.0.8",
    "@wordpress/api-fetch": "^8.0.0",
    "@wordpress/components": "^43.0.0",
    "@wordpress/core-data": "^9.0.0",
    "@wordpress/data": "^11.0.0",
    "@wordpress/dom-ready": "^5.0.0",
    "@wordpress/editor": "^16.0.0",
    "@wordpress/element": "^10.0.0",
    "@wordpress/hooks": "^5.0.0",
    "@wordpress/html-entities": "^5.0.0",
    "@wordpress/i18n": "^7.0.0",
    "@wordpress/notices": "^6.0.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  }
